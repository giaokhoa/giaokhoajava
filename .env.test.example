# Shell-compatible TEST-only example. Copy outside Git, replace secrets, source in test shell.
# With Docker-in-Docker in DevContainer, published TEST ports are reachable on 127.0.0.1.
TEST_DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/giaokhoa_test
TEST_DATABASE_USERNAME=giaokhoa_test
TEST_DATABASE_PASSWORD=replace-with-test-db-password
# User TEST của compose.test.yaml là owner của schema: làm migration role và hiện vẫn
# kiêm datasource của ứng dụng trong TEST; runtime role giaokhoa_runtime đã được tạo ở
# migration V027 nhưng TEST chưa chuyển sang dùng — điều kiện chuyển ghi ở Sổ B83.
TEST_DATABASE_MIGRATOR_USERNAME=giaokhoa_test
TEST_DATABASE_MIGRATOR_PASSWORD=replace-with-test-db-password

TEST_KEYCLOAK_BASE_URL=http://127.0.0.1:18081
TEST_KEYCLOAK_REALM=giaokhoa-it
# T014 disposable native policy fixture only (master admin of TEST realm's Keycloak).
TEST_KEYCLOAK_MASTER_USERNAME=test-admin
TEST_KEYCLOAK_MASTER_PASSWORD=replace-with-test-admin-password
TEST_OIDC_CLIENT_ID=giaokhoa-it-web
TEST_OIDC_CLIENT_SECRET=replace-with-test-web-client-secret
TEST_KEYCLOAK_AUTHZ_AUDIENCE=giaokhoa-it-api
TEST_KEYCLOAK_PROVISIONER_CLIENT_ID=giaokhoa-it-provisioner
TEST_KEYCLOAK_PROVISIONER_CLIENT_SECRET=replace-with-test-provisioner-secret
# Dedicated service account in TEST realm with only manage-users for ephemeral fixtures.
TEST_KEYCLOAK_ADMIN_CLIENT_ID=giaokhoa-it-fixtures
TEST_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-test-fixtures-client-secret

TEST_APP_ORIGIN=http://localhost:8080
TEST_BACKEND_ORIGIN=http://localhost:8080
TEST_FRONTEND_ORIGIN=http://localhost:3001
TEST_MAILPIT_URL=http://127.0.0.1:18025
