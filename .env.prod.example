# Biến môi trường cho stack production (infra/compose.prod.yaml): đặt trong
# tab Environment của Compose service trên Dokploy, hoặc sao chép thành
# .env.prod (không commit) khi chạy tay. Chỉ là mẫu: thay mọi giá trị
# "replace-with-..." trước khi khởi động.
# Topology (hostname, issuer, audience, URL nội bộ) đã chốt trong
# infra/compose.prod.yaml; file này chỉ giữ secret phải cấp riêng.

# Mật khẩu role owner của app-db; cũng là mật khẩu Flyway dùng để migrate
# (SPRING_FLYWAY_PASSWORD lấy cùng giá trị này trong compose).
APP_DB_PASSWORD=replace-with-app-db-owner-password

# Mật khẩu database riêng của Keycloak.
KEYCLOAK_DB_PASSWORD=replace-with-keycloak-db-password

# Tài khoản admin bootstrap của Keycloak: dùng để dựng realm lần đầu bằng
# infra/keycloak/bootstrap.sh và quản trị về sau. Admin console lộ tại
# https://auth.fuckr.net nên mật khẩu phải mạnh.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-keycloak-admin-password

# Mật khẩu role runtime giaokhoa_runtime: phải khớp mật khẩu đặt ở lệnh tạo
# LOGIN cho role trong bước dựng lần đầu (xem infra/DEPLOY.md).
SPRING_DATASOURCE_PASSWORD=replace-with-runtime-db-password

# Hai client secret của realm giaokhoa: phải khớp giá trị truyền cho
# infra/keycloak/bootstrap.sh khi dựng realm; hai secret phải khác nhau và
# tối thiểu 16 ký tự (script tự kiểm tra).
OIDC_CLIENT_SECRET=replace-with-confidential-web-client-secret
KEYCLOAK_PROVISIONER_CLIENT_SECRET=replace-with-provisioner-client-secret
