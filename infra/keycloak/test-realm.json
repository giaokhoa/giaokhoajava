{
  "realm": "giaokhoa-it",
  "enabled": true,
  "organizationsEnabled": true,
  "passwordPolicy": "hashIterations(1000)",
  "sslRequired": "none",
  "verifyEmail": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "smtpServer": {
    "host": "test-mailpit",
    "port": "1025",
    "from": "no-reply@test.giaokhoa.localhost",
    "auth": "false",
    "starttls": "false",
    "ssl": "false"
  },
  "clients": [
    {
      "clientId": "giaokhoa-it-web",
      "name": "Integration TEST login only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ci-web-client-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "backchannel.logout.session.required": "true",
        "backchannel.logout.url": "http://host.docker.internal:18080/logout/connect/back-channel/keycloak",
        "post.logout.redirect.uris": "http://127.0.0.1:8080/",
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://127.0.0.1:18888/callback",
        "http://127.0.0.1:8080/login/oauth2/code/keycloak",
        "http://localhost:8080/login/oauth2/code/keycloak"
      ]
    },
    {
      "clientId": "giaokhoa-it-fixtures",
      "name": "Integration TEST fixtures only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ci-fixtures-only",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "giaokhoa-it-api",
      "name": "Integration TEST protected resources",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": false,
      "clientAuthenticatorType": "client-secret",
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "decisionStrategy": "UNANIMOUS",
        "policyEnforcementMode": "ENFORCING"
      }
    }
  ],
  "groups": [
    {
      "name": "gk",
      "subGroups": [
        {
          "name": "identity",
          "subGroups": [
            {
              "name": "eligible"
            }
          ]
        },
        {
          "name": "platform",
          "subGroups": [
            {
              "name": "operators"
            }
          ]
        },
        {
          "name": "workspaces"
        }
      ]
    }
  ]
}
