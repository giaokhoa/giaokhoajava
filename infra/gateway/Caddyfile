http://giaokhoa.localhost:3000 {
	@backend path /api /api/* /oauth2/* /login /login/* /logout /logout/* /actuator/*
	handle @backend {
		reverse_proxy app:8080 {
			header_up X-Forwarded-Port 3000
			header_up -X-Forwarded-Prefix
		}
	}
	handle {
		# Header bảo mật cho tài liệu HTML do Next phục vụ; `>` (defer) để đặt
		# sau khi proxy đã ghi header của nó. script-src cần 'unsafe-inline'
		# vì Next chèn inline script chứa RSC payload — không có nonce thì
		# 'self' trần chặn hydration (nâng cấp: cấp nonce theo request).
		# Chỉ ở môi trường dev: script-src thêm 'unsafe-eval' vì React dùng
		# eval cho Fast Refresh/tái dựng stack lỗi, style-src thêm
		# 'unsafe-inline' vì dev chèn style nội tuyến — Caddyfile.test
		# (production) không có hai nới này.
		header {
			>Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
			>X-Content-Type-Options "nosniff"
		}
		reverse_proxy app:3001
	}
}

http://auth.giaokhoa.localhost:8081 {
	reverse_proxy keycloak:8080 {
		header_up X-Forwarded-Port 8081
		header_up -X-Forwarded-Prefix
	}
}
